# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Shared database (REQUIRED before charging any group) ---
# Without DATABASE_URL the API keeps data in per-instance memory: records
# entered on one phone are invisible on other phones and vanish on restarts.
# Provision free Postgres at neon.tech, then set:
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# in Vercel → Project → Settings → Environment Variables (all environments).
DATABASE_URL=""

# --- Session auth (REQUIRED before handling real money) ---
# Until SESSION_SECRET is set, the API runs in open-dev mode: anyone with the
# URL can read/overwrite group ledgers and the app skips the PIN gate.
# Set it to any long random string (e.g. output of `openssl rand -hex 32`),
# same value in Vercel env vars AND any self-hosted server environment.
# After setting it, every officer signs in with account + PIN; in-app account
# switching re-asks the PIN.
SESSION_SECRET=""

# --- Plan activation (REQUIRED before selling Pro) ---
# Manual sales flow: the group pays via MoMo to your sales number, you verify
# the payment and activate their plan with this key (never share it):
#   curl -X POST https://YOUR-APP.vercel.app/api/groups/plan \
#     -H 'Content-Type: application/json' -H "x-admin-key: $ADMIN_KEY" \
#     -d '{"groupId":"grp-xxx-yyyy","plan":"pro"}'
# Group devices can never self-upgrade: /api/state strips plan changes
# without this key, and free groups are capped at 30 members server-side.
ADMIN_KEY=""

# --- Mobile-money collections via Flutterwave aggregator (RECOMMENDED) ---
# One integration covers MTN + Airtel UG, with no IP whitelisting on your side
# (Vercel serverless has no static IPs — direct telco integrations stall here).
# Onboarding (30 min + Flutterwave approval wait):
#   1. Create account at dashboard.flutterwave.com → Settings → API Keys.
#      Copy the TEST secret key first (starts FLWSECK_TEST_).
#   2. Settings → Webhooks: add https://YOUR-APP.vercel.app/api/momo/webhook
#      and set a random secret hash below (e.g. output of `openssl rand -hex 24`).
#   3. Set the vars below (test key + MOMO_LIVE=1), redeploy, run a UGX 500
#      test collection from the MoMo screen — test mode auto-approves.
#   4. Complete Flutterwave business KYC, swap in the LIVE secret key, redeploy.
# Direct MTN/Airtel keys below remain as fallback and are used only when
# no Flutterwave key is set.
FLW_SECRET_KEY=""
FLW_SECRET_HASH=""
FLW_CUSTOMER_EMAIL="noreply@vsla-ug.app"

# --- MoMo live collections, direct provider path (fallback) ---
# The app runs in SANDBOX simulation until these are set.
# Set MOMO_LIVE=1 plus both provider credentials to switch the MoMo Push screen to LIVE mode.
# Live collections remain pending until the provider status endpoint confirms them.
MOMO_LIVE="0"
# MTN MoMo Open API (https://momodeveloper.mtn.com) — Collection product
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER_ID=""
MTN_MOMO_API_KEY=""
MTN_MOMO_ENVIRONMENT="sandbox" # use "production" only with live MTN credentials
MTN_MOMO_CALLBACK_URL=""
# Airtel Money Africa API (https://developers.airtel.africa)
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
AIRTEL_ENVIRONMENT="sandbox" # use "production" only with live Airtel credentials
