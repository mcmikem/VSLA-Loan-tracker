{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/groups/create", "destination": "/api/groups?action=create" },
    { "source": "/api/groups/join", "destination": "/api/groups?action=join" },
    { "source": "/api/groups/plan", "destination": "/api/groups?action=plan" },
    { "source": "/api/groups/:id/invite", "destination": "/api/groups?action=invite&id=:id" },
    { "source": "/api/accounts", "destination": "/api/auth?action=accounts" },
    { "source": "/api/accounts/switch", "destination": "/api/auth?action=switch" },
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/status", "destination": "/api/auth?action=status" },
    { "source": "/api/backup/restore", "destination": "/api/backup?action=restore" },
    { "source": "/api/backup/snapshot", "destination": "/api/backup?action=snapshot" },
    { "source": "/api/backup/reset", "destination": "/api/backup?action=reset" },
    { "source": "/api/momo/config", "destination": "/api/momo?action=config" },
    { "source": "/api/momo/push", "destination": "/api/momo?action=push" },
    { "source": "/api/seed/preset", "destination": "/api/seed?action=preset" },
    { "source": "/app", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
